<Application x:Class="HdrBooth.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Color x:Key="BrandRed">#D92D3A</Color>
        <SolidColorBrush x:Key="BrandBrush" Color="{StaticResource BrandRed}" />
        <SolidColorBrush x:Key="InkBrush" Color="#252525" />
        <SolidColorBrush x:Key="MutedBrush" Color="#777777" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F6F7F9" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
