<Window x:Class="HdrBooth.Views.EventSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Event" Height="720" Width="940" MinHeight="650" MinWidth="820"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Window.Resources>
        <Style TargetType="TextBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="8,6"/><Setter Property="BorderBrush" Value="#DCDDDF"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel"><Setter Property="Foreground" Value="#555"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
    </Window.Resources>
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="PENGATURAN EVENT" Foreground="#D92D3A" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="EventNameText" Text="Nama Event" FontSize="26" FontWeight="Bold" Foreground="#222" Margin="0,4,0,0"/>
            <TextBlock Text="Semua perubahan disimpan khusus untuk event ini." Foreground="#777" Margin="0,4,0,0"/>
        </StackPanel>
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E7E7E7" Padding="12">
            <TabItem Header="Welcome &amp; Penutup">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
                    <TextBlock Text="Welcome Screen" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Judul" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WelcomeTitleBox"/>
                    <TextBlock Text="Subjudul" Style="{StaticResource FieldLabel}"/><TextBox x:Name="WelcomeSubtitleBox"/>
                    <Separator Margin="0,22"/>
                    <TextBlock Text="Layar Penutup" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Judul penutup" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClosingTitleBox"/>
                    <TextBlock Text="Subjudul penutup" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ClosingSubtitleBox"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Layout &amp; Timer">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Pengaturan sesi foto" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Layout foto" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="LayoutBox"><ComboBoxItem Content="Strip 4 Foto"/><ComboBoxItem Content="Strip 3 Foto"/><ComboBoxItem Content="Kolase 2x2"/><ComboBoxItem Content="Foto 4x6"/></ComboBox>
                    <TextBlock Text="Jumlah jepretan" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PhotoCountBox"/>
                    <TextBlock Text="Countdown (detik)" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CountdownBox"/>
                    <TextBlock Text="Batas retake" Style="{StaticResource FieldLabel}"/><TextBox x:Name="RetakeBox"/>
                    <TextBlock Text="Folder frame" Style="{StaticResource FieldLabel}"/><TextBox x:Name="FrameFolderBox"/>
                    <Button Content="Buka Frame Editor" Width="180" HorizontalAlignment="Left" Margin="0,12,0,0"
                            Background="#D92D3A" Foreground="White" Click="OpenFrameEditor_Click"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Kamera &amp; Printer">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18" MaxWidth="560" HorizontalAlignment="Left">
                    <TextBlock Text="Kamera" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Perangkat kamera" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CameraIdBox"/>
                    <TextBlock Text="Mode kamera" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="CameraModeBox"><ComboBoxItem Content="Auto"/><ComboBoxItem Content="Canon EOS EDSDK"/><ComboBoxItem Content="Canon EOS Utility"/><ComboBoxItem Content="USB / Webcam"/><ComboBoxItem Content="Demo / Pengujian"/></ComboBox>
                    <Border Background="#FFF5F5" BorderBrush="#F1D0D3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="DIAGNOSTIK CANON EDSDK" Foreground="#A52A35" FontWeight="Bold"/>
                            <TextBlock x:Name="CanonSdkStatusText" Text="Status SDK belum diperiksa." TextWrapping="Wrap" Foreground="#555" Margin="0,6,0,8"/>
                            <Button Content="PERIKSA CANON EDSDK" Width="190" HorizontalAlignment="Left" Click="CheckCanonSdk_Click"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Catatan: deteksi SDK bukan berarti kamera sudah tersambung. Live View dan shutter Canon akan diaktifkan setelah DLL SDK resmi dan proses inisialisasi diuji pada Windows dengan kamera." TextWrapping="Wrap" Foreground="#777" Margin="0,12,0,0"/>
                    <Separator Margin="0,22"/><TextBlock Text="Printer" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Nama printer" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="PrinterNameBox" IsEditable="True" MinWidth="300"/>
                    <Button Content="MUAT ULANG DAFTAR PRINTER" Width="230" HorizontalAlignment="Left" Margin="0,8,0,8" Click="RefreshPrinters_Click"/>
                    <TextBlock Text="Ukuran cetak" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="PrintSizeBox"><ComboBoxItem Content="4x6 inci"/><ComboBoxItem Content="2x6 inci"/><ComboBoxItem Content="5x7 inci"/><ComboBoxItem Content="A4"/></ComboBox>
                    <TextBlock Text="Jumlah salinan" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PrintCopiesBox"/>
                </StackPanel></ScrollViewer>
            </TabItem>
            <TabItem Header="Cloud, Pembayaran &amp; Voucher">
                <StackPanel Margin="18">
                    <TextBlock Text="Berbagi dan akses" FontSize="17" FontWeight="Bold"/>
                    <CheckBox x:Name="QrCheck" Content="Aktifkan QR Code untuk berbagi foto"/>
                    <CheckBox x:Name="CloudCheck" Content="Aktifkan unggah cloud (memerlukan koneksi internet)"/>
                    <CheckBox x:Name="PaymentCheck" Content="Wajibkan pembayaran sebelum sesi"/>
                    <CheckBox x:Name="VoucherCheck" Content="Aktifkan voucher"/>
                    <TextBlock Text="Kode voucher" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VoucherCodeBox" Width="300" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="HDR BOOTH Extra">
                <StackPanel Margin="18">
                    <TextBlock Text="Format hasil foto" FontSize="17" FontWeight="Bold"/>
                    <CheckBox x:Name="FramedCheck" Content="Simpan foto dalam frame"/>
                    <CheckBox x:Name="OriginalCheck" Content="Simpan semua foto original di luar frame"/>
                    <CheckBox x:Name="GifCheck" Content="Buat GIF dari seluruh jepretan"/>
                    <CheckBox x:Name="LivePhotoCheck" Content="Aktifkan Live Photo dalam frame"/>
                    <CheckBox x:Name="MovingPolaroidCheck" Content="Aktifkan Moving Polaroid AR"/>
                    <Border Background="#FFF5F5" CornerRadius="8" Padding="12" Margin="0,18,0,0">
                        <TextBlock Text="Catatan: opsi ini menyimpan preferensi event. Mesin pemrosesan GIF, Live Photo, dan AR akan diintegrasikan pada milestone fitur berikutnya." TextWrapping="Wrap" Foreground="#8B4047"/>
                    </Border>
                </StackPanel>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <TextBlock Text="Pengaturan tersimpan per event" Foreground="#777" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Width="100" Height="38" Margin="0,0,10,0" Click="Cancel_Click"/>
                <Button Content="Simpan Pengaturan" Width="170" Height="38" Background="#D92D3A" Foreground="White" FontWeight="SemiBold" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
