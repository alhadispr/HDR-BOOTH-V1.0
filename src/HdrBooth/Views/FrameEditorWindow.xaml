<Window x:Class="HdrBooth.Views.FrameEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frame Editor - HDR BOOTH" Height="760" Width="1120" MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="#F5F6F8">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="2"/></Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="FRAME EDITOR" Foreground="#D92D3A" FontWeight="Bold" FontSize="11"/>
                <TextBlock x:Name="EventTitle" Text="Event" FontSize="24" FontWeight="Bold" Foreground="#202124"/>
                <TextBlock Text="Atur PNG frame dan area tempat setiap foto akan ditempatkan." Foreground="#777"/>
            </StackPanel>
            <Button DockPanel.Dock="Right" Content="Pilih PNG Frame" Click="ChooseFrame_Click" Background="#D92D3A" Foreground="White" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#E9EAED" CornerRadius="10" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Image x:Name="FramePreview" Stretch="Uniform"/>
                    <Canvas x:Name="SlotOverlay" IsHitTestVisible="False"/>
                    <TextBlock x:Name="EmptyHint" Text="Pilih PNG transparan untuk melihat preview frame" Foreground="#777"
                               HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </Grid>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Area foto (persentase canvas)" FontSize="17" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBlock x:Name="FramePathText" Text="Belum ada PNG frame" Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <WrapPanel>
                            <Button Content="+ Tambah slot" Click="AddSlot_Click"/>
                            <Button Content="Hapus slot" Click="RemoveSlot_Click"/>
                            <Button Content="Perbarui preview" Click="Refresh_Click"/>
                        </WrapPanel>
                    </StackPanel>
                    <DataGrid x:Name="SlotsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" Margin="0,10,0,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nama" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="X %" Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Y %" Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                            <DataGridTextColumn Header="Lebar %" Binding="{Binding Width, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="Tinggi %" Binding="{Binding Height, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock DockPanel.Dock="Bottom" Text="X/Y adalah posisi kiri-atas. Lebar/tinggi adalah ukuran slot. Nilai 0-100%." Foreground="#777" TextWrapping="Wrap" Margin="0,10,0,0"/>
                </DockPanel>
            </Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Template disimpan khusus untuk event ini." Foreground="#777" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Batal" Click="Cancel_Click"/>
                <Button Content="Simpan Template" Click="Save_Click" Background="#D92D3A" Foreground="White" FontWeight="SemiBold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
