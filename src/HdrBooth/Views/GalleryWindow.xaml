<Window x:Class="HdrBooth.Views.GalleryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Galeri Event" Width="980" Height="650" MinWidth="760" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="Galeri Acara" FontSize="24" FontWeight="Bold" Foreground="#252525"/>
            <TextBlock Text="Telusuri, cari, dan buka hasil foto dari event ini." Foreground="#777" Margin="0,5,0,0"/>
        </StackPanel>
        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBox x:Name="SearchBox" Width="300" Height="36" Padding="10,6" VerticalContentAlignment="Center"
                     ToolTip="Cari nama file atau jenis output" TextChanged="SearchBox_TextChanged"/>
            <TextBlock Text="  Cari file" VerticalAlignment="Center" Foreground="#777"/>
            <Button Content="MUAT ULANG" DockPanel.Dock="Right" Width="120" Height="36" Click="Refresh_Click"/>
        </DockPanel>
        <DataGrid x:Name="FilesGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White"
                  MouseDoubleClick="FilesGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="JENIS" Binding="{Binding Kind}" Width="120"/>
                <DataGridTextColumn Header="NAMA FILE / PAKET" Binding="{Binding FileName}" Width="2*"/>
                <DataGridTextColumn Header="STATUS AR" Binding="{Binding ArStatus}" Width="210"/>
                <DataGridTextColumn Header="URL ARTWORK" Binding="{Binding ArtworkUrl}" Width="2*"/>
                <DataGridTextColumn Header="DIMODIFIKASI" Binding="{Binding Modified, StringFormat={}{0:dd MMM yyyy HH:mm}}" Width="160"/>
                <DataGridTextColumn Header="UKURAN" Binding="{Binding SizeText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="CountText" Foreground="#777" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="BUKA FILE TERPILIH" Width="160" Height="38" Margin="0,0,8,0" Click="OpenSelected_Click"/>
                <Button Content="BUKA FOLDER EVENT" Width="170" Height="38" Click="OpenFolder_Click" Background="#D92D3A" Foreground="White"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
