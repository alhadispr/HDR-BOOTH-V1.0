<Window x:Class="HdrBooth.Views.GlobalSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Global — HDR BOOTH" Height="650" Width="820"
        MinHeight="560" MinWidth="720" WindowStartupLocation="CenterOwner"
        Background="#F6F7F9">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Pengaturan Global" FontSize="26" FontWeight="Bold" Foreground="#252525"/>
            <TextBlock Text="Berlaku untuk aplikasi HDR BOOTH secara keseluruhan, bukan untuk satu event tertentu."
                       Foreground="#777" Margin="0,5,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" BorderBrush="#ECEDEF" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="UMUM APLIKASI" FontWeight="Bold" Foreground="#D92D3A" Margin="0,0,0,14"/>
                        <TextBlock Text="Nama aplikasi" Foreground="#666"/>
                        <TextBox x:Name="AppNameBox" Height="34" Padding="8" Margin="0,5,0,12"/>
                        <TextBlock Text="Bahasa antarmuka" Foreground="#666"/>
                        <ComboBox x:Name="LanguageBox" Height="34" Margin="0,5,0,0">
                            <ComboBoxItem Content="Bahasa Indonesia"/>
                            <ComboBoxItem Content="English"/>
                        </ComboBox>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#ECEDEF" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PENYIMPANAN &amp; BACKUP" FontWeight="Bold" Foreground="#D92D3A" Margin="0,0,0,14"/>
                        <TextBlock Text="Folder data utama aplikasi" Foreground="#666"/>
                        <TextBox x:Name="DataFolderBox" Height="34" Padding="8" Margin="0,5,0,12" IsReadOnly="True"/>
                        <TextBlock Text="Folder backup" Foreground="#666"/>
                        <DockPanel Margin="0,5,0,0">
                            <Button Content="Pilih Folder" DockPanel.Dock="Right" Padding="14,6" Click="BrowseBackup_Click"/>
                            <TextBox x:Name="BackupFolderBox" Height="34" Padding="8" Margin="0,0,8,0"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <Border Background="White" BorderBrush="#ECEDEF" BorderThickness="1" CornerRadius="10" Padding="20">
                    <StackPanel>
                        <TextBlock Text="PREFERENSI BOOTH" FontWeight="Bold" Foreground="#D92D3A" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ConfirmExitCheck" Content="Tampilkan konfirmasi sebelum menutup aplikasi" Margin="0,4"/>
                        <CheckBox x:Name="AutoOpenDashboardCheck" Content="Tampilkan dashboard saat aplikasi dibuka" Margin="0,4"/>
                        <TextBlock Text="Catatan: pilihan kamera, printer, layout, timer, dan tampilan pelanggan tetap disimpan pada masing-masing event."
                                   TextWrapping="Wrap" Foreground="#777" FontSize="11" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Batal" Padding="18,9" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Simpan Pengaturan Global" Padding="18,9" Background="#D92D3A" Foreground="White" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
