<Window x:Class="HdrBooth.Views.SessionHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Riwayat Sesi" Width="900" Height="590" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#F6F7F9">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock x:Name="TitleText" Text="RIWAYAT SESI" Foreground="#D92D3A" FontSize="11" FontWeight="Bold"/>
            <TextBlock x:Name="EventNameText" Text="Nama Event" FontSize="25" FontWeight="Bold" Foreground="#222" Margin="0,4,0,0"/>
            <TextBlock x:Name="SummaryText" Text="Memuat riwayat..." Foreground="#777" Margin="0,5,0,0"/>
        </StackPanel>
        <DataGrid x:Name="SessionsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" Background="White" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID SESI" Binding="{Binding ShortId}" Width="130"/>
                <DataGridTextColumn Header="MULAI" Binding="{Binding StartedAt, StringFormat={}{0:dd MMM yyyy HH:mm:ss}}" Width="2*"/>
                <DataGridTextColumn Header="SELESAI" Binding="{Binding CompletedAt, StringFormat={}{0:dd MMM yyyy HH:mm:ss}}" Width="2*"/>
                <DataGridTextColumn Header="FOTO" Binding="{Binding PhotoCount}" Width="70"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Riwayat sesi hanya menampilkan data event ini." Foreground="#777" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="MUAT ULANG" Width="120" Height="38" Margin="0,0,8,0" Click="Refresh_Click"/>
                <Button Content="TUTUP" Width="100" Height="38" Click="Close_Click" Background="#D92D3A" Foreground="White"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>