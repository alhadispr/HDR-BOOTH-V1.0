<Window x:Class="HdrBooth.Views.BoothDisplayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR BOOTH DISPLAY" Width="1440" Height="900" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E9E9EC" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <TextBlock Text="HDR BOOTH" Foreground="#D92D3A" FontSize="23" FontWeight="ExtraBold" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="EventNameText" Foreground="#555" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,18,0"/>
                    <Button Content="Tutup Display" Click="Close_Click" Padding="14,7" Background="White" BorderBrush="#DDDDDD" BorderThickness="1"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="34">
            <Grid x:Name="WelcomePanel" Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="760">
                    <TextBlock Text="PHOTOBOOTH EXPERIENCE" Foreground="#D92D3A" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <TextBlock x:Name="WelcomeTitleText" Text="Selamat Datang" FontSize="54" FontWeight="Bold" Foreground="#222" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="WelcomeSubtitleText" Text="Abadikan momen spesial Anda" FontSize="22" Foreground="#6B7280" TextAlignment="Center" Margin="0,14,0,34"/>
                    <Button Content="MULAI FOTO" Click="Start_Click" Background="#D92D3A" Foreground="White" FontSize="19" FontWeight="Bold" Padding="50,20" HorizontalAlignment="Center" BorderThickness="0"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="LayoutPanel" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="700">
                    <TextBlock Text="PILIH LAYOUT FOTO" FontSize="32" FontWeight="Bold" Foreground="#222" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LayoutDescriptionText" Text="Layout mengikuti konfigurasi event yang dipilih admin." Foreground="#777" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,20"/>
                    <Border Background="White" BorderBrush="#D92D3A" BorderThickness="2" CornerRadius="14" Padding="24" HorizontalAlignment="Center">
                        <StackPanel>
                            <TextBlock x:Name="LayoutNameText" Text="Strip 4 Foto" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                            <Border Background="#F5F5F6" CornerRadius="8" Padding="10">
                                <Grid>
                                    <Image x:Name="LayoutFramePreviewImage" Stretch="Uniform" MaxHeight="300"/>
                                    <UniformGrid x:Name="LayoutSlotsPanel" Rows="1" Columns="4"/>
                                    <TextBlock x:Name="LayoutPreviewHintText" Text="Preview layout event" Foreground="#888"
                                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,6,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Button Content="LANJUTKAN" Click="Continue_Click" Background="#D92D3A" Foreground="White" FontWeight="Bold" Padding="34,15" Margin="0,26,0,0" HorizontalAlignment="Center" BorderThickness="0"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="CameraPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#202124" CornerRadius="14" Margin="0,0,22,0" ClipToBounds="True">
                    <Grid>
                        <Image x:Name="CameraPreviewImage" Stretch="Uniform"/>
                        <Border x:Name="CaptureFlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False"/>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#B3000000" CornerRadius="5" Margin="14" Padding="10,6">
                            <TextBlock x:Name="CameraStatusText" Text="Memeriksa kamera..." Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <Border x:Name="CameraCountdownOverlay" Visibility="Collapsed"
                                Background="#99000000" CornerRadius="22" Padding="34,18"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock x:Name="CameraCountdownOverlayText" Text="3" Foreground="White"
                                       FontSize="104" FontWeight="ExtraBold" TextAlignment="Center"
                                       MinWidth="120"/>
                        </Border>
                        <Border x:Name="CaptureResultOverlay" Visibility="Collapsed"
                                Background="#D9000000" CornerRadius="10" Padding="16,9"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                                IsHitTestVisible="False">
                            <TextBlock x:Name="CaptureResultText" Text="FOTO 1 TERSIMPAN"
                                       Foreground="White" FontSize="16" FontWeight="Bold"/>
                        </Border>
                        <TextBlock x:Name="PreviewHintText" Text="Preview kamera akan tampil di sini" Foreground="#D6D6D6"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="16"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SIAPKAN DIRI" Foreground="#D92D3A" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="PhotoCountText" Text="4 FOTO" FontSize="30" FontWeight="Bold" Foreground="#222" Margin="0,8,0,8"/>
                    <TextBlock Text="Pastikan posisi sudah siap sebelum kamera mengambil gambar." Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <TextBlock x:Name="CaptureProgressText" Text="0 foto diambil" Foreground="#777" Margin="0,0,0,12"/>
                    <TextBlock x:Name="CountdownText" Text="" Foreground="#D92D3A" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <Button x:Name="CaptureButton" Content="AMBIL FOTO" Click="Capture_Click" Background="#D92D3A" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="18,12" Margin="0,0,0,10"/>
                    <Button x:Name="RetakeButton" Content="ULANGI FOTO TERAKHIR" Click="Retake_Click" IsEnabled="False" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="18,12" Margin="0,0,0,10"/>
                    <Button Content="KEMBALI" Click="BackToLayout_Click" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="18,12" Margin="0,0,0,10"/>
                    <Button Content="SELESAI / REVIEW" Click="Review_Click" Background="White" BorderBrush="#DDD" BorderThickness="1" Padding="18,12"/>
                </StackPanel>
            </Grid>
            <Grid x:Name="ReviewPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#202124" CornerRadius="14" Margin="0,0,22,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="REVIEW HASIL FOTO" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,0,0,14"/>
                        <TabControl x:Name="ReviewPreviewTabs" Background="#202124" BorderThickness="0" Height="570">
                            <TabItem Header="FOTO FINAL">
                                <Border Background="#202124" Padding="8">
                                    <Image x:Name="FinalPhotoImage" Stretch="Uniform"/>
                                </Border>
                            </TabItem>
                            <TabItem Header="GIF">
                                <Border Background="#202124" Padding="8">
                                    <WebBrowser x:Name="GifPreviewBrowser"/>
                                </Border>
                            </TabItem>
                            <TabItem Header="LIVE PHOTO">
                                <Grid Background="#202124">
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <MediaElement x:Name="LivePhotoMedia" Grid.Row="0" LoadedBehavior="Manual" UnloadedBehavior="Stop"
                                                  Stretch="Uniform" MediaEnded="LivePhotoMedia_MediaEnded"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                                        <Button Content="PLAY" Click="LivePhotoPlay_Click" Padding="14,6" Margin="3"/>
                                        <Button Content="PAUSE" Click="LivePhotoPause_Click" Padding="14,6" Margin="3"/>
                                        <Button Content="STOP" Click="LivePhotoStop_Click" Padding="14,6" Margin="3"/>
                                    </StackPanel>
                                </Grid>
                            </TabItem>
                        </TabControl>
                        <TextBlock x:Name="ReviewStatusText" Text="Periksa hasil foto sebelum mengakhiri sesi." Foreground="#DDD" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="HASIL SESI" Foreground="#D92D3A" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="ReviewCountText" Text="0 FOTO" FontSize="30" FontWeight="Bold" Foreground="#222" Margin="0,8,0,8"/>
                    <TextBlock Text="PILIH FOTO UNTUK DIULANG" Foreground="#777" FontSize="11" FontWeight="Bold" Margin="0,8,0,4"/>
                    <ScrollViewer Height="170" VerticalScrollBarVisibility="Auto">
                        <WrapPanel x:Name="PhotoThumbnailPanel"/>
                    </ScrollViewer>
                    <TextBlock Text="Periksa hasil foto. Anda masih bisa kembali untuk mengulang foto terakhir." Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,24"/>
                    <Button Content="PILIH VIDEO LIVE PHOTO (MP4)" Click="SelectLiveVideo_Click" Background="White" BorderBrush="#D92D3A" BorderThickness="1" Padding="14,10" Margin="0,0,0,8"/>
                    <TextBlock x:Name="LivePhotoStatusText" Text="Belum ada video Live Photo." Foreground="#777" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="BUAT QR &amp; BAGIKAN" Click="CreateShareQr_Click" Background="#D92D3A" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="14,10" Margin="0,0,0,8"/>
                    <TextBlock Text="PILIH FOTO UNTUK ARTIVIVE"
                               Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ArtivivePhotoSelector" Height="34" Padding="6" Margin="0,0,0,8"
                              ToolTip="Pilih foto individual yang akan dijadikan Trigger Image"/>
                    <Button Content="EKSPOR PAKET ARTIVIVE AR" Click="CreateMovingPolaroid_Click"
                            Background="#202124" Foreground="White" FontWeight="Bold" BorderThickness="0"
                            Padding="14,10" Margin="0,0,0,8"/>
                    <TextBlock x:Name="MovingPolaroidStatusText"
                               Text="Paket impor Artivive belum disiapkan."
                               Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <TextBlock Text="TAUTAN ARTWORK ARTIVIVE (SETELAH PUBLISH)"
                               Foreground="#555" FontSize="10" FontWeight="Bold" Margin="0,0,0,4"/>
                    <TextBox x:Name="ArtiviveArtworkUrlTextBox"
                             ToolTip="Tempel URL artwork / WebAR dari Artivive setelah Publish"
                             Height="34" Padding="7" Margin="0,0,0,6"
                             TextWrapping="NoWrap"/>
                    <Button Content="SIMPAN TAUTAN &amp; BUAT QR ARTIVIVE"
                            Click="SaveArtiviveLink_Click"
                            Background="#D92D3A" Foreground="White" FontWeight="Bold"
                            BorderThickness="0" Padding="10,8" Margin="0,0,0,8"/>
                    <Border Background="White" CornerRadius="8" Padding="8"
                            HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Image x:Name="ArtiviveQrImage" Width="132" Height="132" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="ArtiviveLinkStatusText"
                               Text="QR Artivive belum dibuat."
                               Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Border Background="White" CornerRadius="8" Padding="8" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Image x:Name="ShareQrImage" Width="132" Height="132" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="ShareStatusText" Text="QR belum dibuat." Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="CETAK FOTO" Click="PrintPhoto_Click" Background="White" BorderBrush="#D92D3A" BorderThickness="1" Padding="14,10" Margin="0,0,0,8"/>
                    <TextBlock x:Name="PrintStatusText" Text="Siap mencetak hasil foto." Foreground="#777" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,12"/>
                    <Button Content="KEMBALI KE KAMERA" Click="ReturnToCamera_Click" Background="White" BorderBrush="#DDD" Padding="18,12" Margin="0,0,0,10"/>
                    <Button x:Name="CompleteButton" Content="SELESAIKAN SESI" Click="Complete_Click" IsEnabled="False" Background="#D92D3A" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="18,12"/>
                </StackPanel>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="#E9E9EC" BorderThickness="0,1,0,0">
            <TextBlock Text="HDR BOOTH • Customer Display" Foreground="#999" FontSize="10" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
