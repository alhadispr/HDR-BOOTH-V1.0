<Window x:Class="HdrBooth.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HDR BOOTH" Height="780" Width="1280" MinHeight="650" MinWidth="1000"
        WindowStartupLocation="CenterScreen" Background="#F6F7F9">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="White" BorderBrush="#ECEDEF" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="24,25,24,28">
                    <TextBlock Text="HDR BOOTH" FontSize="25" FontWeight="ExtraBold" Foreground="#D92D3A"/>
                    <TextBlock Text="PHOTOBOOTH MANAGEMENT" FontSize="9" Foreground="#858585" Margin="1,5,0,0"/>
                </StackPanel>
                <StackPanel Margin="14,0">
                    <Button Content="▦   Dashboard Acara" HorizontalContentAlignment="Left" Background="#FCEBED" Foreground="#D92D3A" Margin="0,0,0,7"/>
                    <Button Content="▧   Galeri" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#444" Margin="0,0,0,7"/>
                    <Button Content="⚙   Pengaturan" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#444"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="24">
                    <Border Height="1" Background="#ECEDEF" Margin="0,0,0,14"/>
                    <TextBlock Text="HDR BOOTH • Versi pengembangan" FontSize="10" Foreground="#999"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="34,28,34,28">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,25">
                <StackPanel>
                    <TextBlock Text="Dashboard Acara" FontSize="27" FontWeight="Bold" Foreground="#252525"/>
                    <TextBlock Text="Kelola event, konfigurasi booth, dan hasil foto." Foreground="#777" Margin="0,5,0,0"/>
                </StackPanel>
                <Button DockPanel.Dock="Right" Content="＋  Buat Acara Baru" Background="#D92D3A" Foreground="White" Click="CreateEvent_Click"/>
            </DockPanel>
            <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,12,0" BorderBrush="#ECEDEF" BorderThickness="1">
                    <StackPanel><TextBlock Text="TOTAL ACARA" FontSize="10" Foreground="#888"/><TextBlock x:Name="TotalEventsText" Text="0" FontSize="29" FontWeight="Bold" Margin="0,6,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,12,0" BorderBrush="#ECEDEF" BorderThickness="1">
                    <StackPanel><TextBlock Text="EVENT AKTIF" FontSize="10" Foreground="#888"/><TextBlock x:Name="ActiveEventText" Text="Belum ada" FontSize="18" FontWeight="Bold" Margin="0,10,0,0"/></StackPanel>
                </Border>
                <Border Background="White" CornerRadius="10" Padding="20" BorderBrush="#ECEDEF" BorderThickness="1">
                    <StackPanel><TextBlock Text="STATUS SISTEM" FontSize="10" Foreground="#888"/><TextBlock Text="Siap dikonfigurasi" FontSize="18" FontWeight="Bold" Foreground="#25845B" Margin="0,10,0,0"/></StackPanel>
                </Border>
            </UniformGrid>
            <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#ECEDEF" BorderThickness="1" Padding="22">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,18">
                        <TextBlock Text="Daftar Acara" FontSize="17" FontWeight="Bold"/>
                        <TextBlock Text="  •  Pilih satu event untuk diaktifkan" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="EventsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                              SelectionMode="Single" SelectionChanged="EventsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAMA ACARA" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="TANGGAL ACARA" Binding="{Binding EventDate, StringFormat={}{0:dd MMM yyyy}}" Width="*"/>
                            <DataGridTextColumn Header="DIBUAT" Binding="{Binding CreatedAt, StringFormat={}{0:dd MMM yyyy}}" Width="*"/>
                            <DataGridCheckBoxColumn Header="AKTIF" Binding="{Binding IsActive}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,15,0,0">
                        <TextBlock x:Name="SelectedEventText" Text="Belum ada event dipilih" Foreground="#777" VerticalAlignment="Center"/>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Riwayat Sesi" Margin="0,0,7,0" Background="#FFFFFF" Foreground="#444" BorderBrush="#DDDDDD" BorderThickness="1" Click="SessionHistory_Click"/>
                            <Button Content="Galeri" Margin="0,0,7,0" Background="#FFFFFF" Foreground="#444" BorderBrush="#DDDDDD" BorderThickness="1" Click="Gallery_Click"/>
                            <Button Content="Edit" Margin="0,0,7,0" Background="#FFFFFF" Foreground="#444" BorderBrush="#DDDDDD" BorderThickness="1" Click="EditEvent_Click"/>
                            <Button Content="Pengaturan" Margin="0,0,7,0" Background="#FFFFFF" Foreground="#D92D3A" BorderBrush="#D92D3A" BorderThickness="1" Click="EventSettings_Click"/>
                            <Button Content="Arsipkan" Margin="0,0,7,0" Background="#FFFFFF" Foreground="#A33" BorderBrush="#E5B9BD" BorderThickness="1" Click="ArchiveEvent_Click"/>
                            <Button Content="Aktifkan Event" Background="#D92D3A" Foreground="White" Click="ActivateEvent_Click"/>
                            <Button Content="Buka Booth Display" Margin="7,0,0,0" Background="#252525" Foreground="White" Click="OpenBoothDisplay_Click"/>
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
